{
  "formatVersion": "1",
  "courseUnits": 12,
  "policy": {
    "productive": "Nur kuratierte, getestete Formen dürfen Aufgaben generieren oder Antworten automatisch bewerten.",
    "reference": "Erklärte Regeln ohne ausreichende Formen für freie Generierung.",
    "deferred": "Historisch widersprüchlich, unvollständig belegt oder noch nicht redaktionell entschieden."
  },
  "units": [
    {
      "unit": 1,
      "theme": "Am Lager ankommen",
      "components": ["formulae", "imperative", "basic-word-order"],
      "outcome": "Begrüßen, danken und einfache Aufforderungen verstehen."
    },
    {
      "unit": 2,
      "theme": "Unterwegs",
      "components": ["noun-phrases", "adjectives", "adverbs"],
      "outcome": "Dinge, Personen und Orte kurz beschreiben."
    },
    {
      "unit": 3,
      "theme": "Im Wald",
      "components": ["definite-article", "soft-mutation", "adjective-position"],
      "outcome": "Bestimmte Dinge und Eigenschaften im Kontext benennen."
    },
    {
      "unit": 4,
      "theme": "Vor dem Tor",
      "components": ["singular-plural", "i-affection", "class-plural"],
      "outcome": "Einzelnes, mehrere und Gruppen unterscheiden."
    },
    {
      "unit": 5,
      "theme": "Richtung und Ort",
      "components": ["prepositions", "direct-object", "indirect-object"],
      "outcome": "Einfachen Weg, Ziel und Handlung ausdrücken."
    },
    {
      "unit": 6,
      "theme": "Wem gehört was?",
      "components": ["possessives", "genitive", "noun-modifiers"],
      "outcome": "Belegte Besitz- und Zugehörigkeitsmuster verstehen."
    },
    {
      "unit": 7,
      "theme": "Was geschieht?",
      "components": ["verb-classes", "selected-attested-verb-forms", "irregular-verbs"],
      "outcome": "Häufige Handlungen mit einzeln belegten Formen anwenden."
    },
    {
      "unit": 8,
      "theme": "Sätze verbinden",
      "components": ["conjunctions", "word-formation", "attested-sentence-patterns"],
      "outcome": "Kuratierte Sätze und kurze Dialoge sicher verbinden."
    },
    {
      "unit": 9,
      "theme": "Neo-Brücke: Mit anderen sprechen",
      "components": ["polite-address", "independent-pronouns", "object-dative-pronouns"],
      "outcome": "Kuratiertes Neo-Sindarin für Anrede, Bitte und Dank einsetzen."
    },
    {
      "unit": 10,
      "theme": "Neo-Brücke: Zeit und Person",
      "components": ["present-tense", "past-tense", "subject-suffixes", "vowel-lengthening"],
      "outcome": "Erweiterte, als Neo gekennzeichnete Verbmuster verstehen."
    },
    {
      "unit": 11,
      "theme": "Neo-Brücke: Zustand und Frage",
      "components": ["copula", "predicative-adjectives", "interrogatives", "negation"],
      "outcome": "Zustände, Fragen und Verneinungen mit klarer Neo-Kennzeichnung bilden."
    },
    {
      "unit": 12,
      "theme": "Freies Spiel",
      "components": ["nasal-mutation", "unusual-plurals", "numbers", "comparative-superlative", "relative-clauses", "participles", "advanced-mutations"],
      "outcome": "Längere, aber weiterhin kuratierte LARP-Dialoge verstehen und bauen."
    }
  ],
